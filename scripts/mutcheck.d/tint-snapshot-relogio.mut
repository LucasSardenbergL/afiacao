# `generated_at` do /keys-snapshot da `tint-sync-agent`: legível, no calendário e não à frente do servidor
# (scanner Lovable Security, lote 6 — achado do Codex na consulta de desenho; money-path).
# @src: supabase/functions/tint-sync-agent/snapshot-relogio.ts
# @test: supabase/functions/tint-sync-agent/snapshot-relogio_test.ts
# @test_cmd: deno test --no-remote --allow-read=supabase/functions
# @compile_cmd: deno check --no-remote
# Rode: bash scripts/mutcheck-all.sh   (o runner sai das diretivas acima — vitest não conhece Deno.test)
# PEGA = a suíte DEVE matar (gate de cobertura). SOBREVIVE = benigno conhecido. ? = exploratório.
#
# Cada linha é um jeito de o agente voltar a reservar o futuro (o banco ordena os snapshots por
# `generated_at` e pula o que vier <= ao último aplicado), ou de um instante ambíguo, ilegível ou
# fora do calendário passar. EXPECT preenchido por MEDIÇÃO.
#
# Fora do contrato, por serem equivalentes: tirar SÓ o dia ou SÓ o mês da conferência de ida e
# volta (o transbordo de um muda o outro), e tirar SÓ o segundo ou SÓ o minuto (idem). Por isso as
# mutações de calendário abaixo tiram o par inteiro.
#
# ── o futuro ──
PEGA | futuro deixa de ser recusado                     | s/if \(instante\.ms > limiteMs \|\| \(instante\.ms === limiteMs && instante\.restoNs > 0\)\) \{/if (false) {/
PEGA | fronteira exclusiva (o limite exato e recusado)  | s/if \(instante\.ms > limiteMs \|\|/if (instante.ms >= limiteMs ||/
PEGA | compara com o lado errado (recusa o passado)     | s/if \(instante\.ms > limiteMs \|\|/if (instante.ms < limiteMs ||/
PEGA | fracao abaixo do ms ignorada na fronteira        | s/ \|\| \(instante\.ms === limiteMs && instante\.restoNs > 0\)\) \{/) {/
PEGA | tolerancia vira 10 horas                         | s/export const TOLERANCIA_FUTURO_MS = 10 \* 60_000;/export const TOLERANCIA_FUTURO_MS = 10 * 60 * 60_000;/
PEGA | tolerancia vira zero                             | s/export const TOLERANCIA_FUTURO_MS = 10 \* 60_000;/export const TOLERANCIA_FUTURO_MS = 0;/
PEGA | tolerancia subtraida em vez de somada            | s/const limiteMs = agoraMs \+ TOLERANCIA_FUTURO_MS;/const limiteMs = agoraMs - TOLERANCIA_FUTURO_MS;/
# ── o fuso ──
PEGA | sinal do fuso invertido                          | s/\(m\[8\] === "-" \? -1 : 1\)/(m[8] === "-" ? 1 : -1)/
PEGA | fuso ignorado (texto lido como UTC)              | s/ms: base\.getTime\(\) - deslocamentoMs \+/ms: base.getTime() +/
PEGA | minutos do fuso ignorados                        | s/\(horas \* 60 \+ minutos\) \* 60_000;/(horas * 60) * 60_000;/
PEGA | fuso acima de 15h aceito                         | s/if \(horas > MAX_HORAS_DE_FUSO \|\| minutos > 59\) return null;/if (minutos > 59) return null;/
PEGA | minuto de fuso 60 aceito                         | s/if \(horas > MAX_HORAS_DE_FUSO \|\| minutos > 59\) return null;/if (horas > MAX_HORAS_DE_FUSO) return null;/
# ── o calendário ──
PEGA | data fora do calendario aceita (mes e dia)       | s/ \|\| base\.getUTCMonth\(\) !== mes - 1 \|\| base\.getUTCDate\(\) !== dia \|\|$/ ||/
PEGA | hora, minuto e segundo nao conferidos            | s/^    base\.getUTCHours\(\) !== hora \|\| base\.getUTCMinutes\(\) !== min \|\| base\.getUTCSeconds\(\) !== seg$/    false/
PEGA | ano abaixo de 100 aceito                         | s/base\.getUTCFullYear\(\) !== ano \|\| //
# ── a fração ──
PEGA | fracao do texto ignorada                         | s/const fracaoNs = m\[7\] === undefined \? 0 : Number\(m\[7\]\.padEnd\(9, "0"\)\);/const fracaoNs = 0;/
PEGA | fracao curta lida como nanossegundo (.5 = 5 ns)  | s/Number\(m\[7\]\.padEnd\(9, "0"\)\)/Number(m[7])/
# ── a forma ──
PEGA | a forma RFC 3339 deixa de ser exigida na entrada | s/if \(typeof valor !== "string" \|\| !RE_RFC3339\.test\(valor\)\) \{/if (typeof valor !== "string") {/
PEGA | fuso deixa de ser obrigatorio                    | s#\(\?:Z\|\(\[\+-\]\)\(\\d\{2\}\):\(\\d\{2\}\)\)\$/;#(?:Z|([+-])(\\d{2}):(\\d{2}))?\$/;#
PEGA | texto depois do instante passa (sem ancora)      | s#\(\?:Z\|\(\[\+-\]\)\(\\d\{2\}\):\(\\d\{2\}\)\)\$/;#(?:Z|([+-])(\\d{2}):(\\d{2}))/;#
PEGA | minusculas aceitas                               | s#\$/;$#\$/i;#
# ── a mensagem ──
PEGA | a recusa nao informa o relogio do servidor       | s/\(server clock: \$\{new Date\(agoraMs\)\.toISOString\(\)\}\)/(server clock)/
