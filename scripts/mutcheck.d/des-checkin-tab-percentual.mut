PEGA | qualitativo ausente vira 0 | s/^ {16}percentual=\{percentualPorCriterio\[c\.id\] \?\? null\}/                percentual={percentualPorCriterio[c.id] ?? 0}/
PEGA | bônus ausente vira 0 | s/^ {20}percentual=\{percentualPorCriterio\[c\.id\] \?\? null\}/                    percentual={percentualPorCriterio[c.id] ?? 0}/
