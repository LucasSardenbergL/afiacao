# Hub: cards 'Posição ao Vivo' e 'Meta Pessoal' leem a empresa do seletor; sem faturado confirmado (ou
# sem meta, ou leitura que falhou) mostram '—' (nem trânsito, nem R$ 0).
# @src: src/pages/PerformanceHub.tsx
# @test: src/pages/__tests__/PerformanceHub.posicao.test.tsx
# Rode: bash scripts/mutcheck.sh src/pages/PerformanceHub.tsx src/pages/__tests__/PerformanceHub.posicao.test.tsx scripts/mutcheck.d/performance-hub-posicao.mut
PEGA | gate ignora o faturado (view antiga passa) | s/const semFaturado = linha\?\.fat_bruto_confirmado == null;/const semFaturado = false;/
PEGA | posição NULL vira 0 | s/Number\(linha\?\.posicao_ao_vivo_otimista \?\? Number\.NaN\)/Number(linha?.posicao_ao_vivo_otimista ?? 0)/
PEGA | leitura que falhou vira 0 | s/\{ posicao: null, meta: null \} as/{ posicao: 0, meta: 0 } as/
PEGA | card formata ausência como R\$ 0 | s/value: data\?\.posicao == null \? "—" : brl\(data\.posicao\)/value: brl(Number(data?.posicao ?? 0))/
PEGA | select esquece o faturado (falha fechada: o controle fica vermelho) | s/\.select\("fat_bruto_confirmado, posicao_ao_vivo_otimista, meta_pessoal"\)/.select("posicao_ao_vivo_otimista, meta_pessoal")/
PEGA | erro do PostgREST ignorado | s/^            if \(error\) throw error;$//
PEGA | empresa fixa OBEN (o seletor volta a ser ignorado) | s/\.eq\("empresa", empresa\)/.eq("empresa", "OBEN")/
PEGA | meta ausente vira 0 | s/Number\(linha\?\.meta_pessoal \?\? Number\.NaN\)/Number(linha?.meta_pessoal ?? 0)/
PEGA | card de meta formata ausência como R\$ 0 | s/value: data\?\.meta == null \? "—" : brl\(data\.meta\)/value: brl(Number(data?.meta ?? 0))/
PEGA | score SPIN volta a 0 fixo | s/value: data\?\.spin == null \? "—" : data\.spin/value: data?.spin ?? 0/
